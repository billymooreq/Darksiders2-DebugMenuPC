# portable tools (restore per tools/VERSIONS.md)
tools/*
!tools/VERSIONS.md
# local paths (scripts/ds2paths.py, scripts/env.bat)
local_paths.ini
local_private_patterns.txt
# Ghidra projects and exports: they contain the game's code -> never commit, rebuild from your own exe
ghidra_project/
ghidra_xbox/
ghidra_export/
*.gzf
*.gpr
*.rep/
*.lock
*.lock~
# dumps made from the game's exe (decompilation, disassembly, strings, tables) -> regenerate locally
dumps/*
!dumps/README.md
# game files and backups (never commit)
backup/
*.exe
*.upak
*.obsp
*.mnfst
*.dsl
worlds.bin
worldnodes32.bin
# build outputs (the DLL is published in GitHub Releases) and logs
build/
logs/
*.obj
*.exp
*.ilk
*.pdb
*.lib
__pycache__/
*.pyc
# planner memory (private)
brain/
