# portable tools (restore per tools/VERSIONS.md)
tools/*
!tools/VERSIONS.md
# Ghidra projects (large, regenerable)
ghidra_project/
ghidra_xbox/
*.gpr
*.rep/
*.lock
*.lock~
# Ghidra headless logs
ghidra_project/*.log
# game file backups
backup/
# game files and full copies (never commit; ghidra_export/*.gzf is the only exception, LFS, private repo)
*.exe
*.upak
*.obsp
*.mnfst
*.dsl
worlds.bin
worldnodes32.bin
# build outputs and logs
build/**/*.obj
build/**/*.exp
build/**/*.ilk
build/**/*.pdb
build/**/*.lib
logs/
# large dumps
dumps/**/*.bin
dumps/**/*.pe
dumps/**/*.exe
dumps/**/*.dll
dumps/big/
__pycache__/
*.pyc
dumps/**/run.log
